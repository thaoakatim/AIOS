NODE_ENV=development

PORT=5002

DATABASE_URL=postgresql://aios_user:aios_password@localhost:5433/aios_db?schema=public

REDIS_URL=redis://localhost:6378

# ----------------------------------------------------------------------------
# LLM Gateway (sinh văn bản)
# ----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=4096

# ----------------------------------------------------------------------------
# Embedding Service (Knowledge & RAG — Task 2.2)
# Mặc định model theo provider đều sinh 768 chiều, khớp cột
# `embedding vector(768)` của bảng `document_chunks`.
#   openai -> text-embedding-3-small (dùng tham số dimensions=768)
#   gemini -> text-embedding-004
#   ollama -> nomic-embed-text
# ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# ----------------------------------------------------------------------------
# Vector Store (Qdrant hoặc pgvector)
# ----------------------------------------------------------------------------
VECTOR_STORE_PROVIDER=pgvector
# VECTOR_STORE_PROVIDER=qdrant
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ----------------------------------------------------------------------------
# Knowledge Ingestion Pipeline
# mode 'sync'  -> xử lý pipeline ngay trong request POST /knowledge/upload
# mode 'queue' -> đẩy job BullMQ, worker xử lý nền
# ----------------------------------------------------------------------------
KNOWLEDGE_PROCESSING_MODE=sync
KNOWLEDGE_CHUNK_SIZE=1200
KNOWLEDGE_CHUNK_OVERLAP=200

# ----------------------------------------------------------------------------
# Local File Storage (file gốc upload)
# ----------------------------------------------------------------------------
LOCAL_STORAGE_PATH=./data/storage
STORAGE_BASE_URL=/api/files